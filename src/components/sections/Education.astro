---
import Section from "../Section.astro"
import { useTranslations } from "@/i18n/utils"
import type { Education } from "@/cv"

interface Props {
  education: Array<Education>
  certificates: Certificate[]
  lang: "en" | "es"
}

interface Certificate {
  name: string
  date: string
  issuer: string
  url: string
}

const { education, certificates, lang } = Astro.props as Props
const t = useTranslations(lang)
const certificateDate = new Intl.DateTimeFormat(lang === "es" ? "es-UY" : "en-US", { month: "short", year: "numeric", timeZone: "UTC" })
---

<Section title={t('section.education')}>
  <ul>
    {
      education.map(({ institution, startDate, endDate, area }) => {
        const startYear = new Date(startDate).getFullYear()
        const endYear =
          endDate != null ? new Date(endDate).getFullYear() : t('work.present')
        const years = `${startYear} - ${endYear}`

        return (
          <li>
            <article>
              <header>
                <div>
                  <h3>{institution}</h3>
                </div>

                <time>{years}</time>
              </header>

              <footer>
                <p>{area}</p>
              </footer>
            </article>
          </li>
        )
      })
    }
    {
      certificates.map(({ name, date, issuer, url }) => (
        <li>
          <article>
            <header>
              <div>
                <h3><a href={url} target="_blank" rel="noopener">{name}</a></h3>
              </div>
              <time datetime={date}>{certificateDate.format(new Date(date))}</time>
            </header>
            <footer><p>{issuer}</p></footer>
          </article>
        </li>
      ))
    }
  </ul>
</Section>

<style>
  ul {
    display: flex;
    flex-direction: column;
    gap: 32px;
  }

  article h3 {
    font-weight: 500;
    color: #111;
  }

  article h3 a {
    color: inherit;
    text-decoration: none;
  }

  article h3 a:hover {
    text-decoration: underline;
  }

  header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 4px;
  }

  time {
    color: #555;
    font-size: 0.85rem;
    min-width: 102px;
  }

  @media (width <= 700px) {
    time {
      text-align: right;
    }
  }
</style>
