---
import Section from "../Section.astro"
import { useTranslations } from "@/i18n/utils"

interface Certificate {
  name: string
  date: string
  issuer: string
  url: string
}

interface Props {
  certificates: Certificate[]
  lang: "en" | "es"
}

const { certificates, lang } = Astro.props as Props
const t = useTranslations(lang)
const formatter = new Intl.DateTimeFormat(lang === "es" ? "es-UY" : "en-US", { month: "short", year: "numeric", timeZone: "UTC" })
---

<Section title={t('section.certifications')}>
  <ul>
    {certificates.map((certificate) => (
      <li>
        <article>
          <div>
            <a href={certificate.url} target="_blank" rel="noopener">{certificate.name}</a>
            <p>{certificate.issuer}</p>
          </div>
          <time datetime={certificate.date}>{formatter.format(new Date(certificate.date))}</time>
        </article>
      </li>
    ))}
  </ul>
</Section>

<style>
  ul { display: flex; flex-direction: column; gap: 12px; padding: 0; }
  li { list-style: none; }
  article { display: flex; justify-content: space-between; gap: 1rem; }
  a { color: #111; font-weight: 600; text-decoration: none; }
  a:hover { text-decoration: underline; }
  p, time { color: #555; font-size: 0.85rem; }
  time { white-space: nowrap; }
  @media (width <= 700px) { article { flex-direction: column; gap: 2px; } }
</style>
