---
import Section from "../Section.astro"
import { useTranslations } from "@/i18n/utils"
import type { Education } from "@/cv"

interface Props {
  education: Array<Education>
  certificates: Certificate[]
  lang: "en" | "es"
}

interface Certificate {
  name: string
  date: string
  issuer: string
  url: string
}

const { education, certificates, lang } = Astro.props as Props
const t = useTranslations(lang)
const certificateDate = new Intl.DateTimeFormat(lang === "es" ? "es-UY" : "en-US", { month: "short", year: "numeric", timeZone: "UTC" })
const certificateGroups = Object.values(
  certificates.reduce<Record<string, Certificate[]>>((groups, certificate) => {
    groups[certificate.issuer] ??= []
    groups[certificate.issuer].push(certificate)
    return groups
  }, {}),
)
---

<Section title={t('section.education')}>
  <ul>
    {
      education.map(({ institution, startDate, endDate, area }) => {
        const startYear = new Date(startDate).getFullYear()
        const endYear =
          endDate != null ? new Date(endDate).getFullYear() : t('work.present')
        const years = `${startYear} - ${endYear}`

        return (
          <li>
            <article>
              <header>
                <div>
                  <h3>{institution}</h3>
                </div>

                <time>{years}</time>
              </header>

              <footer>
                <p>{area}</p>
              </footer>
            </article>
          </li>
        )
      })
    }
    {
      certificateGroups.map((group) => (
        <li>
          <article>
            <header>
              <div>
                <h3>{group[0].issuer}</h3>
              </div>
            </header>
            <footer>
              <ul class="certificates">
                {group.map(({ name, date, url }) => (
                  <li>
                    <a href={url} target="_blank" rel="noopener">{name}</a>
                    <time datetime={date}>{certificateDate.format(new Date(date))}</time>
                  </li>
                ))}
              </ul>
            </footer>
          </article>
        </li>
      ))
    }
  </ul>
</Section>

<style>
  ul {
    display: flex;
    flex-direction: column;
    gap: 32px;
  }

  article h3 {
    font-weight: 500;
    color: #111;
  }

  article h3 a {
    color: inherit;
    text-decoration: none;
  }

  article h3 a:hover {
    text-decoration: underline;
  }

  .certificates {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 0;
  }

  .certificates li {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    list-style: none;
  }

  .certificates a {
    color: #555;
    font-size: 0.9rem;
  }

  .certificates time {
    color: #555;
    font-size: 0.85rem;
    white-space: nowrap;
  }

  header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 4px;
  }

  time {
    color: #555;
    font-size: 0.85rem;
    min-width: 102px;
  }

  @media (width <= 700px) {
    time {
      text-align: right;
    }
  }
</style>
